#!/bin/sh
#
# Writes the agent's kubeconfig, once per harness session:
#
#   hoop-kubeconfig <session id>
#
# kubectl cannot add a header, but it sends impersonation headers from its
# kubeconfig: the session id goes out as Impersonate-Extra-Hoop-Session, and
# the sidecar records it in each row (../rbac.yaml). The harness sets the
# variables (../template.yaml).

set -eu

# The id goes into YAML: accept AgentCore's session id form only.
id=${1:-}
case "$id" in
    *[!A-Za-z0-9_-]*) id= ;;
esac
if [ "${#id}" -lt 33 ] || [ "${#id}" -gt 100 ]; then
    echo "usage: $0 <session id>: 33 to 100 letters, digits, - or _; the first message gives it" >&2
    exit 2
fi
: "${SIDECAR_URL:?not set: the harness sets it}" "${SIDECAR_CA:?not set: the harness sets it}"
: "${KUBE_TOKEN:?not set: the harness sets it}" "${KUBE_USER:?not set: the harness sets it}"
: "${KUBE_NAMESPACE:?not set: the harness sets it}"

# certificate-authority-data: the lane's certificate, and no other CA.
CONFIG=${KUBECONFIG:-$HOME/.kube/config}
mkdir -p "$(dirname "$CONFIG")"
(umask 077; cat > "$CONFIG") <<YAML
apiVersion: v1
kind: Config
clusters: [{name: hoop, cluster: {server: '$SIDECAR_URL', certificate-authority-data: '$SIDECAR_CA'}}]
users:
  - name: agent
    user:
      token: '$KUBE_TOKEN'
      as: '$KUBE_USER'
      as-user-extra: {hoop-session: ['$id']}
contexts: [{name: hoop, context: {cluster: hoop, user: agent, namespace: '$KUBE_NAMESPACE'}}]
current-context: hoop
YAML
echo "kubectl $(kubectl version --client | sed -n 's/^Client Version: //p') reaches $SIDECAR_URL as session $id"
