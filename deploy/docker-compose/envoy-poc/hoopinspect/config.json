{
  "log_level": "info",
  "listeners": [
    {
      "name": "appdb",
      "protocol": "postgres",
      "listen": "0.0.0.0:15432",
      "upstream": "appdb:5432",
      "connection": "appdb"
    },
    {
      "name": "httpbin",
      "protocol": "http",
      "listen": "0.0.0.0:18080",
      "upstream": "httpbin:8080",
      "connection": "httpbin"
    }
  ],
  "policy": {
    "enforce": true,
    "rules": [
      {
        "name": "no-destructive-sql",
        "type": "operation",
        "operations": [
          "drop",
          "delete",
          "truncate"
        ],
        "message": "destructive statements are not permitted on appdb"
      },
      {
        "name": "no-admin-api",
        "type": "http_resource",
        "resources": [
          "/admin/**"
        ],
        "message": "the admin API is not reachable through this proxy"
      },
      {
        "name": "no-internal-ids",
        "type": "http_resource",
        "resources": [
          "/anything/users/*/orders/*"
        ],
        "message": "direct id access is not permitted; use the search endpoint"
      },
      {
        "name": "no-upstream-5xx",
        "type": "http_status",
        "statuses": [
          "5xx"
        ],
        "message": "upstream failure suppressed by policy"
      },
      {
        "name": "graphql-read-only",
        "type": "graphql_operation",
        "graphql_operations": [
          "mutation"
        ],
        "message": "this credential may query but not mutate"
      }
    ]
  },
  "mask": {
    "enabled": true,
    "rules": [
      {
        "name": "emails",
        "entity": "email",
        "strategy": "redact"
      },
      {
        "name": "ssn",
        "entity": "ssn",
        "strategy": "partial",
        "keep_last": 4
      },
      {
        "name": "cards",
        "entity": "credit_card",
        "strategy": "partial",
        "keep_last": 4
      }
    ]
  },
  "audit": {
    "file": "-",
    "memory_buffer": 256,
    "async_queue_size": 1024,
    "query_sessions": 500
  },
  "admin": {
    "listen": "0.0.0.0:19000"
  }
}
