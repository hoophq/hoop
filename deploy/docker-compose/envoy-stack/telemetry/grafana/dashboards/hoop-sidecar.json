    {
      "id": 11,
      "type": "timeseries",
      "title": "p99 by stage",
      "description": "policy = the sidecar's own decision (rules or an OPA round trip); analyzer = the model call; review = a human approval hold; upstream = the database or API answering.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, hoop_stage, hoop_engine) (rate(hoop_sidecar_statement_duration_seconds_bucket{hoop_lane=~\"$lane\"}[1m])))",
          "legendFormat": "{{hoop_stage}} {{hoop_engine}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
