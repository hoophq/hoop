            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum (rate(hoop_sidecar_statements_total{hoop_lane=~\"$lane\", hoop_verdict=\"deny\"}[1m]))) or vector(0)",
          "legendFormat": ""
