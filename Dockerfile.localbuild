# Local from-source build of the hoop gateway+agent image.
#
# Builds BOTH binaries inside linux stages (no host cross-toolchain / rustup
# needed -- works on nix/fenix hosts via Docker's native linux/arm64):
#   - hoop_rs  : the Rust agent (agentrs)
#   - hoop     : the Go gateway/agent/client multi-call binary
#
# Then assembles the same runtime layout as the production Dockerfile so the
# result is a drop-in stand-in for hoophq/hoop:<tag> built from the current
# working tree (including the PII-guard branch).
#
# This is a DEV/LOCAL build aid; it is not used by CI or releases.
#
#   docker build -f Dockerfile.localbuild -t hoophq/hoop:local .

# ---- Stage 1: build hoop_rs (agentrs) -------------------------------------
FROM rust:1-bookworm AS rust-build
WORKDIR /src
# agentrs is self-contained (ring-based TLS, no openssl-sys, no build.rs)
# EXCEPT for one Cargo path dependency: ../libhoop/rdp-guard, the swappable
# RDP PII guard. An unresolvable path dependency is a hard error, so the crate
# has to be in the build context — a bare `COPY agentrs/` does not build.
#
# LIBHOOP_DIR selects the flavor, mirroring what ./libhoop resolves to outside
# Docker:
#   _libhoop (default) -> the OSS passthrough stub. RDP is proxied normally
#                         with no detection or redaction, and the agent
#                         advertises supports_pii_guard=false, so the gateway
#                         refuses any session it would have delegated.
#   libhoop            -> the enterprise guard. Needs a real hoophq/libhoop
#                         checkout at ./libhoop INSIDE the repo; the usual dev
#                         symlink points outside the build context and Docker
#                         cannot follow it.
#
# Building the PII demo stack therefore requires:
#   git clone git@github.com:hoophq/libhoop.git libhoop
#   docker build -f Dockerfile.localbuild --build-arg LIBHOOP_DIR=libhoop \
#       --build-arg CARGO_FEATURES=require-enforcement ...
#
# CARGO_FEATURES=require-enforcement turns "I meant to build the enterprise
# agent but got the stub" into a compile error instead of an agent that
# silently never enforces. Always pass it with LIBHOOP_DIR=libhoop.
ARG LIBHOOP_DIR=_libhoop
ARG CARGO_FEATURES=
COPY agentrs/ ./agentrs/
COPY ${LIBHOOP_DIR}/rdp-guard/ ./libhoop/rdp-guard/
WORKDIR /src/agentrs
RUN cargo build --release ${CARGO_FEATURES:+--features ${CARGO_FEATURES}} && \
    install -D target/release/agentrs /out/hoop_rs

# ---- Stage 2: build hoop (Go multi-call binary) ---------------------------
FROM golang:1.26-bookworm AS go-build
WORKDIR /src
# The whole workspace is needed (go.work references every module). The RDP
# parser wasm is committed and embedded via go:embed, so no wasm toolchain is
# required here.
ARG LIBHOOP_DIR=_libhoop
COPY . .
# `libhoop` must be a usable import path for the Go build. The context can
# deliver it in three shapes and all three have to work:
#   - a symlink (what the repo ships; COPY does not preserve it portably),
#   - a real directory (an enterprise checkout, which is what the documented
#     LIBHOOP_DIR=libhoop flow requires for the Rust stage above),
#   - absent.
# `rm -f` cannot remove a directory, so the previous unconditional
# `rm -f libhoop && ln -s _libhoop libhoop` aborted this stage outright for an
# enterprise checkout — the Go build never ran.
RUN if [ "${LIBHOOP_DIR}" = "libhoop" ]; then \
        test -d libhoop || { echo "LIBHOOP_DIR=libhoop but ./libhoop is not a directory in the build context"; exit 1; }; \
        echo "go stage: using the enterprise libhoop checkout"; \
    else \
        rm -rf libhoop && ln -s "${LIBHOOP_DIR}" libhoop; \
        echo "go stage: using ${LIBHOOP_DIR}"; \
    fi
RUN CGO_ENABLED=0 GOOS=linux go build \
        -ldflags "-s -w -X github.com/hoophq/hoop/common/version.version=local" \
        -o /out/hoop github.com/hoophq/hoop/client

# ---- Stage 2b: build the web UI (CLJS app + React shell) ------------------
# Mirrors scripts/dev/build-webapp.sh: build the shadow-cljs bundle, build the
# React (vite) shell, then merge with the React index.html on top. Needs Node
# + a JDK (shadow-cljs runs on the JVM).
FROM eclipse-temurin:21-jdk-noble AS webapp-build
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends curl ca-certificates gnupg git && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /src
# Copy only the two webapp trees (build context already excludes node_modules
# and prior build outputs via .dockerignore).
COPY webapp/ ./webapp/
COPY webapp_v2/ ./webapp_v2/
# CLJS bundle (downloads connection metadata from the public docs repo).
RUN cd webapp && npm install && npm run release:hoop-ui
# React shell.
RUN cd webapp_v2 && npm install && npm run build
# Merge: CLJS resources first, React shell on top (React index.html wins) ->
# the layout the gateway serves from /app/ui/public.
RUN mkdir -p /ui/public && \
    cp -a webapp/resources/public/. /ui/public/ && \
    cp -a webapp_v2/dist/. /ui/public/

# ---- Stage 3: runtime (mirrors the production Dockerfile) -----------------
FROM ubuntu:noble-20250714
ENV DEBIAN_FRONTEND=noninteractive
ENV ACCEPT_EULA=y

RUN mkdir -p /app && \
    mkdir -p /opt/hoop/sessions && \
    mkdir -p /opt/hoop/bin && \
    apt-get update -y && \
    apt-get install -y \
        xz-utils \
        locales \
        tini \
        openssh-client \
        procps \
        gettext-base \
        curl \
        tesseract-ocr \
        tesseract-ocr-eng && \
    rm -rf /var/cache/apt/archives /var/lib/apt/lists/*

RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

COPY rootfs /
COPY --from=go-build     /out/hoop    /app/hoop
COPY --from=rust-build   /out/hoop_rs /app/hoop_rs
COPY --from=webapp-build /ui/public   /app/ui/public
RUN chown root:root /app/hoop* && chmod 755 /app/hoop*

EXPOSE 8009
EXPOSE 8010
EXPOSE 15432

ENV PATH="/app:${PATH}"
ENV PATH="/opt/hoop/bin:${PATH}"

ENTRYPOINT ["tini", "--"]
CMD ["hoop", "start", "agent"]
