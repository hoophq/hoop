# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Bare binaries dropped in the repo root by `go build ./<module>/cmd/<name>/`
# (without -o). Listed explicitly rather than by pattern because these names are
# only safe to ignore while nothing else at the root uses them — note ./gateway
# is deliberately absent, as it would shadow the gateway module directory.
/openapi-gen
/rdpbench
/spiffe-mint
/hsh-tunneld

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# IDE related
.cursor/
agent/.idea/*
agentrs/.idea/*
client/.idea/*
gateway/.idea/*
plugins/.idea/*
common/.idea/*
.idea/*
.vscode/*
.fleet/*
.clj-kondo/*
.lsp/*
.calva
.bacon-locations
# Dependency directories (remove the comment below to include it)
# vendor/

dist/
# Release artifacts for the tunnel daemon live under tunnel/dist/; the
# `scripts/` subtree is part of the published tarball (RD-226) and
# must be tracked. Built tarballs / signed archives still stay
# ignored via the broader `dist/` rule above.
!tunnel/dist/
!tunnel/dist/scripts/
!tunnel/dist/scripts/**
rootfs/app/ui
build
go.work.sum
.env

.DS_Store
# an optional local clone of the private libhoop module, for `make libhoop-dev`
libhoop
.terraform*

# certs
*.v3.ext
*.crt
*.csr
*.srl
*.key

# misc dev code
client/cmd/auth
client/cmd/custom.go
gateway/cmd/gateway/.env
rest-client/

deploy/docker-compose/hoopdata/terraform/outputs/
deploy/docker-compose/hoopdata/sessions
deploy/docker-compose/hoopdata/zitadel-admin-sa.json

**/.claude/settings.local.json
**/.claude/**
**/.mcp.json
# the root .mcp.json is versioned team config (Linear/Figma MCP servers)
!/.mcp.json

# rust build
target/
webapp/resources/public/data/connections-metadata.json
# .claude/ is versioned team config (settings, skills, hooks) — only
# per-engineer state stays ignored
.claude/worktrees/
.worktrees/
# WASM build output
gateway/rdp/wasm/target/
__pycache__/

# Local RDP benchmark fixture (may contain sensitive screen content); never commit
/recording.json

# Framebuffer snapshots written by `rdpbench run -dump <dir>`. These are decoded
# screenshots of the recorded session — the same sensitive screen content as the
# fixture above, only directly viewable. The dump directory is chosen by the
# caller and can land anywhere in the tree, so match the tool's filename instead.
**/snapshot-*.png

# Local PII-demo agent secret (generated by scripts/dev/run-pii-demo.sh)
deploy/docker-compose/.pii-demo.env

# webapp build staged for go:embed (make embed-webapp)
gateway/webappui/staticui/*
!gateway/webappui/staticui/.gitkeep
