FROM ubuntu:noble-20251013

ENV DEBIAN_FRONTEND=noninteractive
ENV ACCEPT_EULA=y
ARG AWS_CLI_VERSION=2.28.6
ARG GCLOUD_VERSION=533.0.0-0
ARG GCLOUD_GKE_AUTHN_PLUGIN_VERSION=467.0.0-0
ARG NODE_VERSION=22.18.0
# DEP-91: tool versions are ARG-driven so the two trains can diverge. The
# defaults here are the LEGACY (hoophq/hoopdev) pins, kept stable for backward
# compatibility. The CLEAN train — published as the `-clean` tag suffix, and
# the base the hoop-ng/hoopdev-ng repos build on — overrides them to the latest
# releases via build-args in the clean matrix leg of
# .github/workflows/agent-tools-build.yml.
ARG KUBECTL_VERSION=v1.29.15
ARG SQLCMD_VERSION=v1.8.2
ARG MONGOSH_VERSION=2.5.6
ARG MONGODB_TOOLS_VERSION=8.0.12
# Pinned hand-installed downloads. Every version below must have a reviewed
# SHA-256 for both architectures in licenses/agent-tools-checksums.sha256, or
# the build fails at the verification step.
ARG SSM_PLUGIN_VERSION=1.2.835.0
# Oracle Instant Client, per arch. These differ deliberately: amd64 has always
# been pinned to 23.9, while arm64 was fetched from an unversioned "current"
# URL that serves 23.26.1. Pinning arm64 to 23.9 to match would silently
# DOWNGRADE every arm64 agent, so each arch is pinned to the version it ships
# today. Converging them is a deliberate upgrade, not a side effect of adding
# checksums.
ARG ORACLE_CLIENT_VERSION_AMD64=23.9.0.25.07
ARG ORACLE_CLIENT_PATH_AMD64=2390000
ARG ORACLE_CLIENT_VERSION_ARM64=23.26.1.0.0
ARG ORACLE_CLIENT_PATH_ARM64=2326100

# Immutable provenance consumed from the exact published image digest by the
# release-manifest generator. Derived hoopdev images inherit these labels from
# their pinned agent-tools base, so reported versions cannot drift from what
# actually shipped.
LABEL dev.hoop.agent-tools.kubectl.version="${KUBECTL_VERSION}" \
      dev.hoop.agent-tools.sqlcmd.version="${SQLCMD_VERSION}" \
      dev.hoop.agent-tools.mongosh.version="${MONGOSH_VERSION}" \
      dev.hoop.agent-tools.mongodb-tools.version="${MONGODB_TOOLS_VERSION}" \
      dev.hoop.agent-tools.node.version="${NODE_VERSION}" \
      dev.hoop.agent-tools.aws-cli.version="${AWS_CLI_VERSION}" \
      dev.hoop.agent-tools.gcloud.version="${GCLOUD_VERSION}" \
      dev.hoop.agent-tools.gke-gcloud-auth-plugin.version="${GCLOUD_GKE_AUTHN_PLUGIN_VERSION}"

# The legacy MongoDB 5.0 shell (/usr/local/bin/mongo) is SSPL-licensed. It is
# kept on the default "legacy" image train for backward compatibility, and
# excluded from the "clean" train (INCLUDE_LEGACY_MONGO=false), which ships only
# mongosh (Apache-2.0). This default will flip to false once the legacy train is
# retired. Declared and license-gated in licenses/manual-binaries.toml.
ARG INCLUDE_LEGACY_MONGO=true

# Common
RUN mkdir -p /app && \
    apt update -y && \
    apt install -y \
    python3.12 \
    locales \
    tini \
    apt-utils \
    curl \
    gnupg \
    gnupg2 \
    net-tools \
    netcat-openbsd \
    jq \
    openssh-client \
    unzip \
    expect \
    less \
    gettext-base \
    lsb-release \
    libaio1t64 \
    # DEP-91: alien, elfutils, libelf-dev and python3-dev are not in the base
    # package set; they pull linux-libc-dev (kernel headers, ~891 CVEs) and
    # libc6-dev, and nothing in this image needs them at runtime (every CLI is
    # prebuilt; Oracle ships a zip, not an rpm). The legacy train reinstates
    # them below - see INCLUDE_BUILD_HEADERS. python3-pip moved below to skip
    # its python3-dev recommend.
    bc \
    bzip2 \
    # xz-utils: required to extract the Node.js .tar.xz below. Previously pulled
    # transitively by alien/python3-pip recommends (both removed above), so it
    # is now declared explicitly.
    xz-utils \
    wget \
    redis-tools && \
    # groff (for `aws help`) and python3-pip are installed without Recommends:
    # groff's recommends pull ghostscript (AGPL)/imagemagick/netpbm/psutils (GPL)
    # for PostScript output nothing here produces; python3-pip's recommend pulls
    # python3-dev -> linux-libc-dev, and boto3/requests are pure-Python wheels
    # so pip needs no headers.
    apt install -y --no-install-recommends groff python3-pip && \
    ln -s /usr/bin/python3 /usr/bin/python

# DEP-91 / downstream compatibility. The build headers are the single largest
# CVE contributor in this image, but hoophq/agent-tools is the base of
# hoophq/hoopdev, and downstream images built FROM hoophq/hoopdev pip-install
# native extensions (pyodbc, pymssql, ...) that compile from source whenever no
# wheel matches their interpreter/architecture. Dropping the headers from the
# default train would break those builds on their next base bump, so they stay
# on LEGACY and are dropped only from the opt-in CLEAN train, which has no
# installed base to protect.
#
# Retiring them from the legacy train is a separate, announced change: every
# consumer must first install its own build deps or pin wheel-only installs.
ARG INCLUDE_BUILD_HEADERS=true
RUN if [ "$INCLUDE_BUILD_HEADERS" = "true" ]; then \
      apt install -y \
        python3-dev \
        unixodbc-dev=2.3.12-1ubuntu0.24.04.1 \
        alien \
        elfutils \
        libelf-dev; \
    else \
      echo "INCLUDE_BUILD_HEADERS=false: skipping build/kernel headers (clean train)"; \
    fi

# https://github.com/nodejs/release-keys
RUN ARCH= && dpkgArch="$(dpkg --print-architecture)" \
    && case "${dpkgArch##*-}" in \
    amd64) ARCH='x64';; \
    ppc64el) ARCH='ppc64le';; \
    s390x) ARCH='s390x';; \
    arm64) ARCH='arm64';; \
    armhf) ARCH='armv7l';; \
    i386) ARCH='x86';; \
    *) echo "unsupported architecture"; exit 1 ;; \
    esac \
    && export GNUPGHOME="$(mktemp -d)" \
    && set -ex \
    && for key in \
    5BE8A3F6C8A5C01D106C0AD820B1A390B168D356 \
    4ED778F539E3634C779C87C6D7062848A1AB005C \
    141F07595B7B3FFE74309A937405533BE57C7D57 \
    74F12602B6F1C4E913FAA37AD3A89613643B6201 \
    DD792F5973C6DE52C432CBDAC77ABFA00DDBF2B7 \
    61FC681DFB92A079F1685E77973F295594EC4689 \
    8FCCA13FEF1D0C2E91008E09770F7A9A5AE15600 \
    C4F0DFFF4E8C1A8236409D08E73BC641CC11F4C8 \
    890C08DB8579162FEE0DF9DB8BEAB4DFCF555EF4 \
    C82FA3AE1CBEDC6BE46B9360C43CEC45C17AB93C \
    108F52B48DB57BB0CC439B2997B01419BD92F80A \
    A363A499291CBBC940DD62E41F10027AF002F8B0 \
    CC68F5A3106FF448322E48ED27F5E38D5B0A215F \
    ; do \
    gpg --batch --keyserver hkps://keys.openpgp.org --recv-keys "$key" || \
    gpg --batch --keyserver keyserver.ubuntu.com --recv-keys "$key" ; \
    done \
    && curl -fsSLO --compressed "https://nodejs.org/dist/v$NODE_VERSION/node-v$NODE_VERSION-linux-$ARCH.tar.xz" \
    && curl -fsSLO --compressed "https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt.asc" \
    && gpg --batch --decrypt --output SHASUMS256.txt SHASUMS256.txt.asc \
    && gpgconf --kill all \
    && rm -rf "$GNUPGHOME" \
    && grep " node-v$NODE_VERSION-linux-$ARCH.tar.xz\$" SHASUMS256.txt | sha256sum -c - \
    && tar -xJf "node-v$NODE_VERSION-linux-$ARCH.tar.xz" -C /usr/local --strip-components=1 --no-same-owner \
    && rm "node-v$NODE_VERSION-linux-$ARCH.tar.xz" SHASUMS256.txt.asc SHASUMS256.txt \
    && ln -s /usr/local/bin/node /usr/local/bin/nodejs \
    && node --version \
    && npm --version

# Build-time integrity roots for versioned, hand-installed executables. The
# verifier fails closed on missing, duplicate, or mismatched reviewed digests.
COPY licenses/agent-tools-checksums.sha256 scripts/ci/verify-manual-download.py /opt/hoop/build-integrity/

RUN dpkgArch="$(dpkg --print-architecture)" \
    && artifact="kubectl-${KUBECTL_VERSION}-linux-${dpkgArch}" \
    && curl --fail --location --silent --show-error \
      --proto '=https' --tlsv1.2 \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${dpkgArch}/kubectl" \
      --output "$artifact" \
    && python3 /opt/hoop/build-integrity/verify-manual-download.py \
      /opt/hoop/build-integrity/agent-tools-checksums.sha256 "$artifact" \
    && install -m 0755 "$artifact" /usr/local/bin/kubectl \
    && rm -f "$artifact" \
    && kubectl version --client=true

RUN ARCH= && dpkgArch="$(dpkg --print-architecture)" \
    && case "${dpkgArch##*-}" in \
    amd64) ARCH='x86_64';; \
    arm64) ARCH='aarch64';; \
    *) echo "unsupported architecture"; exit 1 ;; \
    esac \
    && artifact="awscli-exe-linux-${ARCH}-${AWS_CLI_VERSION}.zip" \
    && curl --fail --location --silent --show-error \
      --proto '=https' --tlsv1.2 \
      "https://awscli.amazonaws.com/${artifact}" \
      --output "$artifact" \
    && python3 /opt/hoop/build-integrity/verify-manual-download.py \
      /opt/hoop/build-integrity/agent-tools-checksums.sha256 "$artifact" \
    && unzip -q "$artifact" \
    && aws/install \
    && aws --version \
    && rm -rf "$artifact" aws

# DEP-91: pinned to a version path. plugin/latest/ is mutable, so its bytes
# cannot be reviewed or pinned, and `dpkg -i` runs this package's maintainer
# scripts as root during the build — verify before installing.
RUN ARCH= && dpkgArch="$(dpkg --print-architecture)" \
  && case "${dpkgArch##*-}" in \
  amd64) ARCH='ubuntu_64bit';; \
  arm64) ARCH='ubuntu_arm64';; \
  *) echo "unsupported architecture"; exit 1 ;; \
  esac \
  && artifact="session-manager-plugin-${SSM_PLUGIN_VERSION}-${ARCH}.deb" \
  && curl --fail --location --silent --show-error \
    --proto '=https' --tlsv1.2 \
    "https://s3.amazonaws.com/session-manager-downloads/plugin/${SSM_PLUGIN_VERSION}/${ARCH}/session-manager-plugin.deb" \
    --output "$artifact" \
  && python3 /opt/hoop/build-integrity/verify-manual-download.py \
    /opt/hoop/build-integrity/agent-tools-checksums.sha256 "$artifact" \
  && dpkg -i "$artifact" \
  && rm -f "$artifact" \
  && session-manager-plugin --version

# Third-party apt repositories and their signing keys.
#
# DEP-91: each key's full OpenPGP fingerprint is asserted before it is trusted.
# A downloaded key IS the trust root for everything apt then installs from that
# repository — and maintainer scripts run as root during the build — so
# accepting whatever bytes the key URL happens to return would make every
# checksum pinned elsewhere in this file beside the point.
#
# Keys go to per-repository keyrings referenced by `signed-by=`, not to global
# trust: without it, any one of these vendors' keys could sign packages
# claiming to come from any other repository, including Ubuntu's own.
#
# The Microsoft key that used to be added here (via the deprecated `apt-key`,
# into global trust) is gone: no Microsoft apt repository is configured in this
# image. sqlcmd is a checksum-verified tarball from GitHub, so the key granted
# archive-wide signing authority for nothing.
ARG MONGODB_KEY_FPR=4B0752C1BCA238C0B4EE14DC41DE058A4E7DCA05
ARG GOOGLE_CLOUD_KEY_FPR=35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3
RUN set -eu; \
    mkdir -p /usr/share/keyrings; \
    tmp="$(mktemp -d)"; \
    trap 'rm -rf "$tmp"' EXIT; \
    fetch_key() { \
      name="$1"; url="$2"; expected="$3"; keyring="$4"; \
      curl --fail --location --silent --show-error \
        --proto '=https' --tlsv1.2 "$url" --output "$tmp/$name"; \
      gpg --dearmor < "$tmp/$name" > "$tmp/$name.gpg"; \
      actual="$(gpg --show-keys --with-colons --with-fingerprint "$tmp/$name.gpg" \
        | awk -F: '/^fpr:/{print $10; exit}')"; \
      if [ "$actual" != "$expected" ]; then \
        echo "::error::$name signing key fingerprint mismatch: expected $expected, got ${actual:-none}"; \
        exit 1; \
      fi; \
      install -m 0644 "$tmp/$name.gpg" "$keyring"; \
      echo "$name signing key verified: $actual"; \
    }; \
    fetch_key mongodb https://www.mongodb.org/static/pgp/server-8.0.asc \
      "$MONGODB_KEY_FPR" /usr/share/keyrings/mongodb-server-8.0.gpg; \
    fetch_key google-cloud https://packages.cloud.google.com/apt/doc/apt-key.gpg \
      "$GOOGLE_CLOUD_KEY_FPR" /usr/share/keyrings/cloud.google.gpg; \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
      > /etc/apt/sources.list.d/google-cloud-sdk.list; \
    echo "deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-8.0.gpg] https://repo.mongodb.org/apt/ubuntu noble/mongodb-org/8.0 multiverse" \
      > /etc/apt/sources.list.d/mongodb-org-8.0.list

# legacy mongo client (MongoDB 5.0 shell, SSPL). Included only on the legacy
# train; the clean train ships mongosh (Apache-2.0) instead. libssl1.1 (and the
# focal-security/Ubuntu-20.04 apt source it comes from) is set up inside this
# guard so the clean train carries neither.
RUN if [ "$INCLUDE_LEGACY_MONGO" = "true" ]; then \
      ARCH= && LIBSSL_1_1_REPO= && dpkgArch="$(dpkg --print-architecture)" \
      && case "${dpkgArch##*-}" in \
      amd64) ARCH='x86_64'; LIBSSL_1_1_REPO='deb http://security.ubuntu.com/ubuntu focal-security main';; \
      arm64) ARCH='aarch64'; LIBSSL_1_1_REPO='deb http://ports.ubuntu.com/ubuntu-ports focal-security main';; \
      *) echo "unsupported architecture"; exit 1 ;; \
      esac \
      && echo "$LIBSSL_1_1_REPO" > /etc/apt/sources.list.d/focal-security.list \
      && artifact="mongodb-linux-$ARCH-ubuntu2004-5.0.31.tgz" \
      && curl --fail --location --silent --show-error --compressed \
        --proto '=https' --tlsv1.2 \
        "https://fastdl.mongodb.org/linux/$artifact" --output "$artifact" \
      && python3 /opt/hoop/build-integrity/verify-manual-download.py \
        /opt/hoop/build-integrity/agent-tools-checksums.sha256 "$artifact" \
      && apt update -y && apt install libssl1.1 -y \
      && tar -xzf "$artifact" \
      && mv mongodb-linux-$ARCH-ubuntu2004-5.0.31/bin/mongo /usr/local/bin/mongo \
      && rm -rf "$artifact" mongodb-linux-$ARCH-ubuntu2004-5.0.31 \
      && mongo --version ; \
    else \
      echo "INCLUDE_LEGACY_MONGO=false: skipping legacy SSPL mongo 5.0 shell (clean train)"; \
    fi

RUN apt update -y && apt install -y \
    mongodb-mongosh=${MONGOSH_VERSION} \
    mongodb-org-tools=${MONGODB_TOOLS_VERSION} \
    default-mysql-client=1.1.0build1 \
    # DEP-91: the ODBC runtime (libodbc2 + isql) is all this image uses. The
    # -dev headers pull linux-libc-dev, so they ship only where a downstream
    # build may need them - reinstated with the other build headers above.
    unixodbc=2.3.12-1ubuntu0.24.04.1 \
    postgresql-client-16=16.14-0ubuntu0.24.04.1 \
    google-cloud-cli=$GCLOUD_VERSION \
    google-cloud-sdk-gke-gcloud-auth-plugin=$GCLOUD_GKE_AUTHN_PLUGIN_VERSION && \
    artifact="sqlcmd-linux-$(dpkg --print-architecture)-${SQLCMD_VERSION}.tar.bz2" && \
      curl --fail --location --silent --show-error \
        --proto '=https' --tlsv1.2 \
        "https://github.com/microsoft/go-sqlcmd/releases/download/${SQLCMD_VERSION}/sqlcmd-linux-$(dpkg --print-architecture).tar.bz2" \
        --output "$artifact" && \
      python3 /opt/hoop/build-integrity/verify-manual-download.py \
        /opt/hoop/build-integrity/agent-tools-checksums.sha256 "$artifact" && \
      tar -xf "$artifact" -C /usr/local/bin/ sqlcmd && \
      rm -f "$artifact" && \
      sqlcmd --version && \
      rm -rf /var/lib/apt/lists/*

# configure libaio symlink for oracle client
RUN ARCH= && dpkgArch="$(dpkg --print-architecture)" \
    && case "${dpkgArch##*-}" in \
    amd64) ln -s /usr/lib/x86_64-linux-gnu/libaio.so.1t64 /usr/lib/x86_64-linux-gnu/libaio.so.1;; \
    arm64) ln -s /usr/lib/aarch64-linux-gnu/libaio.so.1t64 /usr/lib/aarch64-linux-gnu/libaio.so.1;; \
    *) echo "unsupported architecture"; exit 1 ;; \
    esac

# Download and install Oracle Instant Client and SQL*Plus.
#
# DEP-91: both architectures now use a versioned path. The unversioned arm64
# URLs used previously were a moving "current" pointer, so arm64's Instant
# Client version could change under a fixed Dockerfile. Each arch is pinned to
# the version it ships today (see the ARGs above). sqlplus is executed below,
# so the archives are verified before anything is unpacked.
RUN ORACLE_ARCH= && ORACLE_VERSION= && ORACLE_PATH= && dpkgArch="$(dpkg --print-architecture)" \
    && case "${dpkgArch##*-}" in \
    amd64) ORACLE_ARCH='x64'; ORACLE_VERSION="${ORACLE_CLIENT_VERSION_AMD64}"; ORACLE_PATH="${ORACLE_CLIENT_PATH_AMD64}";; \
    arm64) ORACLE_ARCH='arm64'; ORACLE_VERSION="${ORACLE_CLIENT_VERSION_ARM64}"; ORACLE_PATH="${ORACLE_CLIENT_PATH_ARM64}";; \
    *) echo "unsupported architecture"; exit 1 ;; \
    esac \
    && basic="instantclient-basic-linux.${ORACLE_ARCH}-${ORACLE_VERSION}.zip" \
    && sqlplus="instantclient-sqlplus-linux.${ORACLE_ARCH}-${ORACLE_VERSION}.zip" \
    && base="https://download.oracle.com/otn_software/linux/instantclient/${ORACLE_PATH}" \
    && mkdir -p /opt/oracle && cd /opt/oracle \
    && for artifact in "$basic" "$sqlplus"; do \
         curl --fail --location --silent --show-error \
           --proto '=https' --tlsv1.2 \
           "${base}/${artifact}" --output "$artifact" && \
         python3 /opt/hoop/build-integrity/verify-manual-download.py \
           /opt/hoop/build-integrity/agent-tools-checksums.sha256 "$artifact" || exit 1; \
       done \
    && unzip -j "$basic" 'instantclient_*/*' -d instantclient \
    && unzip -j "$sqlplus" 'instantclient_*/*' -d instantclient \
    && rm -rf META-INF "$basic" "$sqlplus" \
    && echo 'set markup csv on delimiter "\t" quote off\nset heading on echo off termout off\nset feedback off trimspool on' >> /opt/oracle/instantclient/glogin.sql \
    && LD_LIBRARY_PATH=/opt/oracle/instantclient /opt/oracle/instantclient/sqlplus -V \
    && rm -rf /opt/hoop/build-integrity \
    && cd /

# Configure environment variables
ENV PATH="/opt/oracle/instantclient:$PATH"
ENV LD_LIBRARY_PATH="/opt/oracle/instantclient"

RUN pip3 install -U \
    boto3==1.40.6 \
    requests==2.32.4 \
    --break-system-packages

RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && \
    locale-gen
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV NODE_PATH=/usr/local/lib/node_modules/

ENV PATH="/app:${PATH}"

ENTRYPOINT ["tini", "--"]

