# Agent image with the alcatraz NER model BAKED IN.
#
# The alcatraz DLP provider (DLP_PROVIDER=alcatraz on the gateway) serves the
# statistical entity types — PERSON, LOCATION, NRP — from an ONNX model that
# runs in-process on the agent. The NER backend runs with Offline set: it never
# fetches at runtime, so the model has to already be on disk before the first
# session asks for one of those types. This image is that disk.
#
# The hoop binary is unchanged: the NER runtime is linked into every build. All
# this image adds is ~250MB of model files and the env var pointing at them.
#
# Build (CI passes the released agent image tag as HOOP_IMAGE):
#   docker build -f Dockerfile.agent-alcatraz \
#     --build-arg HOOP_IMAGE=hoophq/hoopdev:<tag> -t hoophq/hoop-agent-alcatraz:<tag> .
#
# Required: the released agent image to build on. No default —
# an unpinned 'latest' base would make derived builds non-reproducible.
#
# HOOP_IMAGE is parameterized rather than fixed to one flavour on purpose. Any
# published hoop *agent* image works, because this file only adds files and one
# env var and leaves the base's user, ENTRYPOINT and CMD alone:
#   hoophq/hoopdev:<tag>              full agent, bundled DB tooling (CI default)
#   hoophq/hoopdev-ng:<tag>           same, clean (AGPL/SSPL-free) train
#   hoophq/hoopagent:<tag>-minimal    agent only, no dev tooling
# The distroless flavour of hoophq/hoopagent is the exception: it has no shell,
# so the verify step below cannot run there. Do NOT point this at hoophq/hoop —
# that is the gateway base image and sets no CMD, so the result would not start
# an agent.
ARG HOOP_IMAGE
ARG GOLANG_IMAGE=golang:1.26-bookworm
# Must match the alcatraz version libhoop links (libhoop/go.mod). The download
# checks every file against a sha256 and an exact byte size pinned inside the
# CLI, and the agent re-checks against that same table when it loads the model,
# so a skew here fails sessions instead of degrading them. CI derives this from
# go.mod rather than trusting the default below.
ARG ALCATRAZ_VERSION=v0.19.0

# ~250MB of ONNX weights, which are architecture-independent. Pinned to
# BUILDPLATFORM so a linux/amd64 + linux/arm64 build fetches and verifies them
# once instead of twice under QEMU; identical bytes on both platforms also mean
# the registry stores and transfers the layer once.
FROM --platform=${BUILDPLATFORM} ${GOLANG_IMAGE} AS models
ARG ALCATRAZ_VERSION
RUN go install github.com/hoophq/alcatraz/cmd/alcatraz@${ALCATRAZ_VERSION}
# a+rX, not a+r: the runtime user below is unprivileged and needs to traverse
# the directories as well as read the files, whatever umask the builder had.
RUN alcatraz models download -dest /opt/alcatraz/models && \
    chmod -R a+rX /opt/alcatraz/models

FROM ${HOOP_IMAGE}

# No USER directive anywhere in this stage: agent images disagree about their
# runtime user (hoophq/hoopdev inherits root from agent-tools, hoophq/hoopagent
# drops to 'hoop'), and hardcoding either would break the other. COPY lands
# root-owned regardless of USER, and the a+rX above makes the result readable
# by whichever user the base picked.
COPY --from=models /opt/alcatraz/models /opt/alcatraz/models
# Shipped so operators can re-run the check below against a running container,
# and so CI can validate the published image without starting an agent. The
# alcatraz root module is pure Go — the ONNX runtime lives in its 'ner'
# submodule, which is not built here.
COPY --from=models /go/bin/alcatraz /usr/local/bin/alcatraz

# The *models* directory: the parent that holds one subdirectory per model id,
# which is what "alcatraz models download --dest" writes into. Not the
# directory of the model itself.
ENV ALCATRAZ_NER_MODEL_PATH=/opt/alcatraz/models

# Fails the build if the files did not survive the COPY. Reads only: no
# network, no writes, safe on a read-only mount. Exits non-zero naming the
# first file that is absent, mismatched or unreadable.
RUN alcatraz models verify -dir "${ALCATRAZ_NER_MODEL_PATH}"

# ENTRYPOINT and CMD are deliberately not set: they are inherited from
# HOOP_IMAGE, which is what keeps this file correct across agent flavours.
