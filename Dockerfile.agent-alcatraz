# Agent image with the alcatraz NER model baked in.
#
# DLP_PROVIDER=alcatraz serves PERSON, LOCATION and NRP from an ONNX model that
# runs in-process on the agent. The NER backend is Offline: it never fetches at
# runtime, so the model must already be on disk. This image is that disk.
#
# The binary is unchanged — this adds ~250MB of weights and one env var.
#
# Nothing here installs or links alcatraz: that dependency lives in libhoop's
# go.mod. The manifest names the files and their layout, so no model id,
# revision, digest or alcatraz version appears in this repository.
#
# One file, one added layer, three published tags — the base decides which:
#
#   HOOP_IMAGE=hoophq/hoopdev:<tag>              -> hoophq/hoop-agent-alcatraz:<tag>
#   HOOP_IMAGE=hoophq/hoopagent:<tag>-minimal    -> hoophq/hoopagent:<tag>-minimal-alcatraz
#   HOOP_IMAGE=hoophq/hoopagent:<tag>-distroless -> hoophq/hoopagent:<tag>-distroless-alcatraz
#
#   docker build -f Dockerfile.agent-alcatraz \
#     --build-arg HOOP_IMAGE=hoophq/hoopdev:<tag> -t hoophq/hoop-agent-alcatraz:<tag> .
#
# The two hoopagent tags land in a clean-only repository (see the bright-line
# note in Dockerfile.agent): what this file adds is model weights served by
# hoop's mirror, carrying no AGPL- or SSPL-licensed component, so they stay on
# the clean side of that line.

# The agent image to build on. No default: an unpinned base makes derived
# builds non-reproducible. Any agent flavour works, because this file only adds
# files and leaves the base's user, ENTRYPOINT and CMD alone — including the
# distroless flavour, which has neither a shell nor a package manager. The one
# image that does not belong here is hoophq/hoop: that is the gateway base and
# would not start an agent.
ARG HOOP_IMAGE
ARG CURL_IMAGE=curlimages/curl:8.11.1

# Hoop's mirror, published by the alcatraz release job. Public-read, so this
# builds outside CI. An ARG so an air-gapped build can swap in its own.
#
# A moving alias, not a revision: rebuilding an old tag may pick up a newer
# model, and model/binary skew is caught when the agent loads. In exchange
# nothing here can drift out of sync with alcatraz's pin table.
ARG ALCATRAZ_MODEL_ORIGIN=https://d3pullut164aif.cloudfront.net/current

# BUILDPLATFORM: the weights are architecture-independent, so a multiarch build
# fetches them once instead of twice under QEMU, and the registry stores one
# layer.
FROM --platform=${BUILDPLATFORM} ${CURL_IMAGE} AS models
ARG ALCATRAZ_MODEL_ORIGIN
# curlimages/curl cannot write under /opt. Throwaway stage only.
USER root
WORKDIR /opt/alcatraz/models

# -f: an origin answering 404 must fail the build, not save the error page as a
# model file. --create-dirs: the manifest names a subdirectory that does not
# exist yet. a+rX: the runtime user may be unprivileged and has to traverse the
# directories.
#
# A digest mismatch is not transient. The one benign cause is a build landing
# in the origin's 300s cache window just after the model changed — retry it,
# never soften this step.
RUN set -eu; \
    curl -fsSL "${ALCATRAZ_MODEL_ORIGIN}/checksums.txt" -o checksums.txt; \
    while read -r _ path; do \
      [ -n "$path" ] || continue; \
      curl -fsSL "${ALCATRAZ_MODEL_ORIGIN}/${path}" --create-dirs -o "$path"; \
    done < checksums.txt; \
    sha256sum -c checksums.txt; \
    chmod -R a+rX /opt/alcatraz/models

FROM ${HOOP_IMAGE}

# No USER here: agent images disagree about their runtime user, and hardcoding
# either would break the other. COPY lands root-owned, and a+rX above makes it
# readable by whichever user the base picked.
COPY --from=models /opt/alcatraz/models /opt/alcatraz/models

# The models directory: the parent holding one subdirectory per model id, not
# the model's own directory.
ENV ALCATRAZ_NER_MODEL_PATH=/opt/alcatraz/models

# No verification step here: distroless has no shell to run one in, and the
# only build this could catch is one where COPY --from lost bytes the models
# stage had just checksummed. The check that matters runs in CI against the
# artifact that landed in the registry, per architecture, by exporting the
# container filesystem — see scripts/ci/verify-alcatraz-image.sh. The manifest
# ships with the model, so that same command answers "is this intact" for any
# copy of the image, running or not.

# ENTRYPOINT and CMD are inherited from HOOP_IMAGE on purpose.
